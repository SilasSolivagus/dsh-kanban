{
  "name": "@local/dsh-kanban",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Native task board for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SilasSolivagus/dsh-kanban.git"
  },
  "homepage": "https://github.com/SilasSolivagus/dsh-kanban#readme",
  "bugs": {
    "url": "https://github.com/SilasSolivagus/dsh-kanban/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
